import copy
import sys

rows, cols = 3, 4

# BUG DEMONSTRATION (Shallow reference replication)
bad = [[0] * cols] * rows  # every row is the SAME list object
bad[0][1] = 7

# TODO 1 Correction: Create a rows x cols grid of zeros using a list comprehension
good = [[0 for _ in range(cols)] for _ in range(rows)]
good[0][1] = 7

print("bad :", bad)
print("good:", good)
print("bad[0] is bad[1]:", bad[0] is bad[1])
print("good[0] is good[1]:", good[0] is good[1])

