# Memory comparison between list and tuple
sample_list = list(range(1000000))
sample_tuple = tuple(range(1000000))
print(f"List size (1M items): {sys.getsizeof(sample_list)} bytes")
print(f"Tuple size (1M items): {sys.getsizeof(sample_tuple)} bytes")
