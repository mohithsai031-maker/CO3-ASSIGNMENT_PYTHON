calls = [
    "seeds not received seeds delayed",
    "fertiliser price high",
    "seeds price high subsidy not received",
]
STOP = {"not", "high"}


def frequencies(texts, stop):
  counts = {}
  for text in texts:
    for word in text.split():
      if word not in stop:
        # TODO 1: Return a dictionary word -> count using dict.get()
        counts[word] = counts.get(word, 0) + 1
  return counts


def top(counts, k):
  # TODO 2: Return the k most frequent (word, count) pairs, highest count first and alphabetical for ties
  # Sorting primarily by count (descending -> -x[1]) and secondarily by word (ascending -> x[0])
  sorted_items = sorted(counts.items(), key=lambda x: (-x[1], x[0]))
  return sorted_items[:k]


print(top(frequencies(calls, STOP), 3))
